    <elementParameter field="MEMO_SQL" name="configuration.dataSet.sqlQuery" value="&quot;SELECT &quot; +&#xD;&#xA;&quot;    p.ID_POZ_DOK_MAG, &quot; +&#xD;&#xA;&quot;    c.DATE_COURS, &quot; +&#xD;&#xA;&quot;    c.TAUX_EUR &quot; +&#xD;&#xA;&quot;FROM &quot; + context.connection_SnowflakeRawSeminPologne_db + &quot;.&quot; + context.connection_SnowflakeRawSeminPologne_schemaName + &quot;.POZYCJA_FAKTURY_V p &quot; +&#xD;&#xA;&quot;ASOF JOIN ( &quot; +&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        dateadd(day, dat.DATA_NOT, date '1800-12-28') AS DATE_COURS, &quot; +&#xD;&#xA;&quot;        kw.KURS_SREDNI / nullif(kw.PRZELICZNIK, 0) AS TAUX_EUR &quot; +&#xD;&#xA;&quot;    FROM &quot; + context.connection_SnowflakeRawSeminPologne_db + &quot;.&quot; + context.connection_SnowflakeRawSeminPologne_schemaName + &quot;.KURSY_WALUT kw &quot; +&#xD;&#xA;&quot;    INNER JOIN &quot; + context.connection_SnowflakeRawSeminPologne_db + &quot;.&quot; + context.connection_SnowflakeRawSeminPologne_schemaName + &quot;.DATY_KURSOW dat ON dat.ID_DATY = kw.ID_DATY &quot; +&#xD;&#xA;&quot;    WHERE kw.SYM_WALUTY = 'EUR' &quot; +&#xD;&#xA;&quot;) c &quot; +&#xD;&#xA;&quot;MATCH_CONDITION (dateadd(day, try_to_number(p.DATA_SPRZEDAZY), date '1800-12-28') >= c.DATE_COURS)&quot;"/>
    <elementParameter field="CHECK" name="configuration.dataSet.dataStore.autoCommit" value="true" show="false"/>
    <elementParameter field="TEXT" name="configuration.dataSet.dataStore.jdbcParameters" value="context.connection_SnowflakeRawLorraineRefendage_jdbcParameters" show="false"/>

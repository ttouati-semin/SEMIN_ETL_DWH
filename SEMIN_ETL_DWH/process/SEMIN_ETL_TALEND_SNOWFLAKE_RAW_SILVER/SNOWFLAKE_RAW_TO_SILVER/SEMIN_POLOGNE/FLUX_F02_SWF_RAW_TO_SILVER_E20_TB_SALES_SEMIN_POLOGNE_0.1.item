    <elementParameter field="MEMO_SQL" name="configuration.dataSet.sqlQuery" value="&quot;SELECT P.ID_POZ_DOK_MAG, P.ID_DOK_HANDLOWEGO, &quot;&#xD;&#xA;+ &quot;P.ID_ARTYKULU, P.ILOSC, P.JEDNOSTKA, &quot;&#xD;&#xA;+ &quot;P.PRZELICZNIK, P.OPIS &quot;&#xD;&#xA;+ &quot;FROM &quot;&#xD;&#xA;+ context.connection_SnowflakeRawSeminPologne_db + &quot;.&quot;&#xD;&#xA;+ context.connection_SnowflakeRawSeminPologne_schemaName + &quot;.POZYCJA_DOKUMENTU_MAGAZYNOWEGO P &quot;&#xD;&#xA;+ &quot;WHERE EXISTS ( &quot;&#xD;&#xA;+ &quot;    SELECT 1 &quot;&#xD;&#xA;+ &quot;    FROM &quot;&#xD;&#xA;+ context.connection_SnowflakeRawSeminPologne_db + &quot;.&quot;&#xD;&#xA;+ context.connection_SnowflakeRawSeminPologne_schemaName + &quot;.DOKUMENT_HANDLOWY DH &quot;&#xD;&#xA;+ &quot;    WHERE DH.ID_DOKUMENTU_HANDLOWEGO = P.ID_DOK_HANDLOWEGO &quot;&#xD;&#xA;+ &quot;    AND DH.DATA_SPRZEDAZY >= DATEDIFF( &quot;&#xD;&#xA;+ &quot;        DAY, DATE '1800-12-28', &quot;&#xD;&#xA;+ &quot;        DATEADD(YEAR, -4, DATE_TRUNC('YEAR', CURRENT_DATE())) &quot;&#xD;&#xA;+ &quot;    ) &quot;&#xD;&#xA;+ &quot;)&quot;"/>

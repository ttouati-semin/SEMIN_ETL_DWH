    <elementParameter field="MEMO_SQL" name="configuration.dataSet.sqlQuery" value="&quot;&#xD;&#xA;WITH&#xD;&#xA;/* ESP : correctif decalage source (06/11/2026). Dans ARTICLE_SEMIN_ESPAGNE, a partir de la position 125,&#xD;&#xA;   les noms de colonnes ne correspondent plus aux valeurs : la valeur du champ NAV de position p-1 est dans la colonne de position p&#xD;&#xA;   (ex. Code Barre EAN13 dans ENTRY_NO__LIST_INVENT__PROFIL, Create Date dans ROLLED_UP_MFG__OVHD_COST).&#xD;&#xA;   Les lignes concernees sont marquees : ESP: correctif decalage source. A retirer si l extraction Bronze est corrigee.&#xD;&#xA;   Hierarchie, ONEBASE, EAN : priorite a l article SEMIN SAS de meme numero (regle de l ancien job ITEM). */&#xD;&#xA;SAS AS (&#xD;&#xA;    SELECT NO_, ONEBASE_PRODUCT_GROUP_CODE, LEV_1___ACTIVITY, LEV_2___ROUTING,&#xD;&#xA;           LEV_3___FAMILY, LEV_4___SUB_FAMILY, GENCODE_EAN13&#xD;&#xA;    FROM &quot; +context.Snowflake_BDD+&quot;.&quot;+context.Snowflake_Schema_SEMIN_SAS+&quot;.ARTICLE_SEMIN_S_A_&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY NO_ ORDER BY NO_) = 1&#xD;&#xA;),&#xD;&#xA;/* ESP : pour les articles absents de SEMIN SAS, on reprend les valeurs de l ancienne table Item espagnole */&#xD;&#xA;ITEM_ESP AS (&#xD;&#xA;    SELECT \&quot;No_\&quot;                        AS NO_IE,&#xD;&#xA;           \&quot;ONEBASE Product Group Code\&quot; AS ONEBASE_IE,&#xD;&#xA;           \&quot;Lev 1 - Activity\&quot;           AS LEV1_IE,&#xD;&#xA;           \&quot;Lev 2 - Routing\&quot;            AS LEV2_IE,&#xD;&#xA;           \&quot;Lev 3 - Family\&quot;             AS LEV3_IE,&#xD;&#xA;           \&quot;Lev 4 - Sub-Family\&quot;         AS LEV4_IE,&#xD;&#xA;           \&quot;Gencode EAN13\&quot;              AS EAN_IE&#xD;&#xA;    FROM &quot; +context.Snowflake_BDD+&quot;.&quot;+context.Snowflake_Schema_SEMIN_ESP+&quot;.\&quot;Item\&quot;&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY \&quot;No_\&quot; ORDER BY \&quot;No_\&quot;) = 1&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;/* ---------- ETAPE 1 : BASE - table article (SEMIN_ESPAGNE) ---------- */&#xD;&#xA;BASE AS (&#xD;&#xA;    SELECT&#xD;&#xA;        CAST(A.NO_                         AS VARCHAR(255)) AS NO_,&#xD;&#xA;        CAST(A.DESCRIPTION                 AS VARCHAR(255)) AS DESCRIPTION,&#xD;&#xA;        CAST(A.CODE_MARQUE                 AS VARCHAR(255)) AS CODE_MARQUE,&#xD;&#xA;        CAST(A.CODE_CLASSE                 AS VARCHAR(255)) AS CODE_CLASSE,&#xD;&#xA;        CAST(IFF(S.NO_ IS NOT NULL, S.ONEBASE_PRODUCT_GROUP_CODE, COALESCE(NULLIF(TRIM(IE.ONEBASE_IE), ''), CASE WHEN TRY_TO_DOUBLE(A.CRITICAL) = 0 THEN NULL ELSE A.CRITICAL END)) AS VARCHAR(255)) AS ONEBASE_PRODUCT_GROUP_CODE, /* ESP: repris de SEMIN SAS */ /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.ITEM_CATEGORY_CODE          AS VARCHAR(255)) AS ITEM_CATEGORY_CODE,&#xD;&#xA;        CAST(IFF(S.NO_ IS NOT NULL, S.LEV_1___ACTIVITY, COALESCE(NULLIF(TRIM(IE.LEV1_IE), ''), CASE WHEN TRY_TO_DOUBLE(A.SINGLE_LEVEL_CAP__OVHD_COST) = 0 THEN NULL ELSE A.SINGLE_LEVEL_CAP__OVHD_COST END)) AS VARCHAR(255)) AS LEV_1___ACTIVITY, /* ESP: repris de SEMIN SAS */ /* ESP: correctif decalage source */&#xD;&#xA;        CAST(IFF(S.NO_ IS NOT NULL, S.LEV_2___ROUTING, COALESCE(NULLIF(TRIM(IE.LEV2_IE), ''), CASE WHEN TRY_TO_DOUBLE(A.SINGLE_LEVEL_MFG__OVHD_COST) = 0 THEN NULL ELSE A.SINGLE_LEVEL_MFG__OVHD_COST END)) AS VARCHAR(255)) AS LEV_2___ROUTING, /* ESP: repris de SEMIN SAS */ /* ESP: correctif decalage source */&#xD;&#xA;        CAST(IFF(S.NO_ IS NOT NULL, S.LEV_3___FAMILY, COALESCE(NULLIF(TRIM(IE.LEV3_IE), ''), CASE WHEN TRY_TO_DOUBLE(A.OVERHEAD_RATE) = 0 THEN NULL ELSE A.OVERHEAD_RATE END)) AS VARCHAR(255)) AS LEV_3___FAMILY, /* ESP: repris de SEMIN SAS */ /* ESP: correctif decalage source */&#xD;&#xA;        CAST(IFF(S.NO_ IS NOT NULL, S.LEV_4___SUB_FAMILY, COALESCE(NULLIF(TRIM(IE.LEV4_IE), ''), CASE WHEN TRY_TO_DOUBLE(A.ROLLED_UP_SUBCONTRACTED_COST) = 0 THEN NULL ELSE A.ROLLED_UP_SUBCONTRACTED_COST END)) AS VARCHAR(255)) AS LEV_4___SUB_FAMILY, /* ESP: repris de SEMIN SAS */ /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.BASE_UNIT_OF_MEASURE        AS VARCHAR(255)) AS BASE_UNIT_OF_MEASURE,&#xD;&#xA;        CAST(A.NET_WEIGHT                  AS VARCHAR(255)) AS NET_WEIGHT,&#xD;&#xA;        CAST(A.NO__2 AS VARCHAR(255)) AS NO__2,&#xD;&#xA;        CAST(A.SEARCH_DESCRIPTION AS VARCHAR(255)) AS SEARCH_DESCRIPTION,&#xD;&#xA;        CAST(A.DESCRIPTION_2 AS VARCHAR(255)) AS DESCRIPTION_2,&#xD;&#xA;        TRY_TO_DOUBLE(A.PRICE_UNIT_CONVERSION) AS PRICE_UNIT_CONVERSION,&#xD;&#xA;        TRY_TO_DOUBLE(A.TYPE) AS TYPE,&#xD;&#xA;        CAST(A.INVENTORY_POSTING_GROUP AS VARCHAR(255)) AS INVENTORY_POSTING_GROUP,&#xD;&#xA;        CAST(A.SHELF_NO_ AS VARCHAR(255)) AS SHELF_NO_,&#xD;&#xA;        CAST(A.ITEM_DISC__GROUP AS VARCHAR(255)) AS ITEM_DISC__GROUP,&#xD;&#xA;        TRY_TO_DOUBLE(A.ALLOW_INVOICE_DISC_) AS ALLOW_INVOICE_DISC,&#xD;&#xA;        TRY_TO_DOUBLE(A.STATISTICS_GROUP) AS STATISTICS_GROUP,&#xD;&#xA;        TRY_TO_DOUBLE(A.COMMISSION_GROUP) AS COMMISSION_GROUP,&#xD;&#xA;        TRY_TO_DOUBLE(A.UNIT_PRICE) AS UNIT_PRICE,&#xD;&#xA;        TRY_TO_DOUBLE(A.PRICE_PROFIT_CALCULATION) AS PRICE_PROFIT_CALCULATION,&#xD;&#xA;        TRY_TO_DOUBLE(A.PROFIT__) AS PROFIT,&#xD;&#xA;        TRY_TO_DOUBLE(A.LAST_DIRECT_COST) AS LAST_DIRECT_COST,&#xD;&#xA;        TRY_TO_DOUBLE(A.INDIRECT_COST__) AS INDIRECT_COST,&#xD;&#xA;        TRY_TO_DOUBLE(A.COST_IS_ADJUSTED) AS COST_IS_ADJUSTED,&#xD;&#xA;        TRY_TO_DOUBLE(A.ALLOW_ONLINE_ADJUSTMENT) AS ALLOW_ONLINE_ADJUSTMENT,&#xD;&#xA;        CAST(A.VENDOR_ITEM_NO_ AS VARCHAR(255)) AS VENDOR_ITEM_NO,&#xD;&#xA;        CAST(A.LEAD_TIME_CALCULATION AS VARCHAR(255)) AS LEAD_TIME_CALCULATION,&#xD;&#xA;        TRY_TO_DOUBLE(A.MAXIMUM_INVENTORY) AS MAXIMUM_INVENTORY,&#xD;&#xA;        TRY_TO_DOUBLE(A.REORDER_QUANTITY) AS REORDER_QUANTITY,&#xD;&#xA;        CAST(A.ALTERNATIVE_ITEM_NO_ AS VARCHAR(255)) AS ALTERNATIVE_ITEM_NO,&#xD;&#xA;        TRY_TO_DOUBLE(A.UNIT_LIST_PRICE) AS UNIT_LIST_PRICE,&#xD;&#xA;        TRY_TO_DOUBLE(A.UNITS_PER_PARCEL) AS UNITS_PER_PARCEL,&#xD;&#xA;        TRY_TO_DOUBLE(A.UNIT_VOLUME) AS UNIT_VOLUME,&#xD;&#xA;        CAST(A.DURABILITY AS VARCHAR(255)) AS DURABILITY,&#xD;&#xA;        CAST(A.FREIGHT_TYPE AS VARCHAR(255)) AS FREIGHT_TYPE,&#xD;&#xA;        CAST(A.TARIFF_NO_ AS VARCHAR(255)) AS TARIFF_NO,&#xD;&#xA;        TRY_TO_DOUBLE(A.DUTY_UNIT_CONVERSION) AS DUTY_UNIT_CONVERSION,&#xD;&#xA;        CAST(A.COUNTRY_REGION_PURCHASED_CODE AS VARCHAR(255)) AS COUNTRY_REGION_PURCHASED_CODE,&#xD;&#xA;        TRY_TO_DOUBLE(A.BUDGETED_AMOUNT) AS BUDGETED_AMOUNT,&#xD;&#xA;        TRY_TO_DOUBLE(A.BUDGET_PROFIT) AS BUDGET_PROFIT,&#xD;&#xA;        TRY_TO_DOUBLE(A.BLOCKED) AS BLOCKED,&#xD;&#xA;        TRY_TO_DOUBLE(A.PRICE_INCLUDES_VAT) AS PRICE_INCLUDES_VAT,&#xD;&#xA;        CAST(A.VAT_BUS__POSTING_GR___PRICE AS VARCHAR(255)) AS VAT_BUS_POSTING_GR_PRICE,&#xD;&#xA;        CAST(A.GEN__PROD__POSTING_GROUP AS VARCHAR(255)) AS GEN_PROD_POSTING_GROUP,&#xD;&#xA;        CAST(A.PICTURE AS VARCHAR(255)) AS PICTURE,&#xD;&#xA;        CAST(A.COUNTRY_REGION_OF_ORIGIN_CODE AS VARCHAR(255)) AS COUNTRY_REGION_OF_ORIGIN_CODE,&#xD;&#xA;        TRY_TO_DOUBLE(A.AUTOMATIC_EXT__TEXTS) AS AUTOMATIC_EXT_TEXTS,&#xD;&#xA;        CAST(A.NO__SERIES AS VARCHAR(255)) AS NO_SERIES,&#xD;&#xA;        CAST(A.TAX_GROUP_CODE AS VARCHAR(255)) AS TAX_GROUP_CODE,&#xD;&#xA;        CAST(A.VAT_PROD__POSTING_GROUP AS VARCHAR(255)) AS VAT_PROD_POSTING_GROUP,&#xD;&#xA;        CAST(A.DEFAULT_DEFERRAL_TEMPLATE_CODE AS VARCHAR(255)) AS DEFAULT_DEFERRAL_TEMPLATE_CODE,&#xD;&#xA;        TRY_TO_DOUBLE(A.LOW_LEVEL_CODE) AS LOW_LEVEL_CODE,&#xD;&#xA;        TRY_TO_DOUBLE(A.LOT_SIZE) AS LOT_SIZE,&#xD;&#xA;        TRY_TO_DOUBLE(A.ROLLED_UP_CAPACITY_COST) AS ROLLED_UP_CAPACITY_COST,&#xD;&#xA;        TRY_TO_DOUBLE(A.SCRAP__) AS SCRAP,&#xD;&#xA;        TRY_TO_DOUBLE(A.INVENTORY_VALUE_ZERO) AS INVENTORY_VALUE_ZERO,&#xD;&#xA;        TRY_TO_DOUBLE(A.DISCRETE_ORDER_QUANTITY) AS DISCRETE_ORDER_QUANTITY,&#xD;&#xA;        TRY_TO_DOUBLE(A.MINIMUM_ORDER_QUANTITY) AS MINIMUM_ORDER_QUANTITY,&#xD;&#xA;        TRY_TO_DOUBLE(A.MAXIMUM_ORDER_QUANTITY) AS MAXIMUM_ORDER_QUANTITY,&#xD;&#xA;        TRY_TO_DOUBLE(A.SAFETY_STOCK_QUANTITY) AS SAFETY_STOCK_QUANTITY,&#xD;&#xA;        TRY_TO_DOUBLE(A.ORDER_MULTIPLE) AS ORDER_MULTIPLE,&#xD;&#xA;        CAST(A.SAFETY_LEAD_TIME AS VARCHAR(255)) AS SAFETY_LEAD_TIME,&#xD;&#xA;        TRY_TO_DOUBLE(A.FLUSHING_METHOD) AS FLUSHING_METHOD,&#xD;&#xA;        TRY_TO_DOUBLE(A.REPLENISHMENT_SYSTEM) AS REPLENISHMENT_SYSTEM,&#xD;&#xA;        TRY_TO_DOUBLE(A.ROUNDING_PRECISION) AS ROUNDING_PRECISION,&#xD;&#xA;        CAST(A.SALES_UNIT_OF_MEASURE AS VARCHAR(255)) AS SALES_UNIT_OF_MEASURE,&#xD;&#xA;        CAST(A.PURCH__UNIT_OF_MEASURE AS VARCHAR(255)) AS PURCH__UNIT_OF_MEASURE,&#xD;&#xA;        CAST(A.TIME_BUCKET AS VARCHAR(255)) AS TIME_BUCKET,&#xD;&#xA;        TRY_TO_DOUBLE(A.REORDERING_POLICY) AS REORDERING_POLICY,&#xD;&#xA;        TRY_TO_DOUBLE(A.INCLUDE_INVENTORY) AS INCLUDE_INVENTORY,&#xD;&#xA;        TRY_TO_DOUBLE(A.MANUFACTURING_POLICY) AS MANUFACTURING_POLICY,&#xD;&#xA;        CAST(A.RESCHEDULING_PERIOD AS VARCHAR(255)) AS RESCHEDULING_PERIOD,&#xD;&#xA;        CAST(A.LOT_ACCUMULATION_PERIOD AS VARCHAR(255)) AS LOT_ACCUMULATION_PERIOD,&#xD;&#xA;        CAST(A.DAMPENER_PERIOD AS VARCHAR(255)) AS DAMPENER_PERIOD,&#xD;&#xA;        TRY_TO_DOUBLE(A.DAMPENER_QUANTITY) AS DAMPENER_QUANTITY,&#xD;&#xA;        TRY_TO_DOUBLE(A.OVERFLOW_LEVEL) AS OVERFLOW_LEVEL,&#xD;&#xA;        TRY_TO_DOUBLE(A.CREATED_FROM_NONSTOCK_ITEM) AS CREATED_FROM_NONSTOCK_ITEM,&#xD;&#xA;        CAST(A.PRODUCT_GROUP_CODE AS VARCHAR(255)) AS PRODUCT_GROUP_CODE,&#xD;&#xA;        CAST(A.SERVICE_ITEM_GROUP AS VARCHAR(255)) AS SERVICE_ITEM_GROUP,&#xD;&#xA;        CAST(A.ITEM_TRACKING_CODE AS VARCHAR(255)) AS ITEM_TRACKING_CODE,&#xD;&#xA;        CAST(A.LOT_NOS_ AS VARCHAR(255)) AS LOT_NOS,&#xD;&#xA;        CAST(A.EXPIRATION_CALCULATION AS VARCHAR(255)) AS EXPIRATION_CALCULATION,&#xD;&#xA;        CAST(A.SPECIAL_EQUIPMENT_CODE AS VARCHAR(255)) AS SPECIAL_EQUIPMENT_CODE,&#xD;&#xA;        CAST(A.PUT_AWAY_TEMPLATE_CODE AS VARCHAR(255)) AS PUT_AWAY_TEMPLATE_CODE,&#xD;&#xA;        CAST(A.PUT_AWAY_UNIT_OF_MEASURE_CODE AS VARCHAR(255)) AS PUT_AWAY_UNIT_OF_MEASURE_CODE,&#xD;&#xA;        CAST(A.PHYS_INVT_COUNTING_PERIOD_CODE AS VARCHAR(255)) AS PHYS_INVT_COUNTING_PERIOD_CODE,&#xD;&#xA;        CASE&#xD;&#xA;            WHEN TRIM(A.LAST_COUNTING_PERIOD_UPDATE) = '-6847808400000' THEN '1753-01-01'::DATE&#xD;&#xA;            WHEN REGEXP_LIKE(TRIM(A.LAST_COUNTING_PERIOD_UPDATE), '^-?[0-9]{11,}$')&#xD;&#xA;                THEN CONVERT_TIMEZONE('UTC', 'Europe/Paris', TO_TIMESTAMP_NTZ(TO_NUMBER(TRIM(A.LAST_COUNTING_PERIOD_UPDATE)), 3))::DATE&#xD;&#xA;            ELSE COALESCE(&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.LAST_COUNTING_PERIOD_UPDATE), ''), 1, 10), 'YYYY-MM-DD'),&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.LAST_COUNTING_PERIOD_UPDATE), ''), 1, 10), 'DD/MM/YYYY'))&#xD;&#xA;        END AS LAST_COUNTING_PERIOD_UPDATE,&#xD;&#xA;        TRY_TO_DOUBLE(A.USE_CROSS_DOCKING) AS USE_CROSS_DOCKING,&#xD;&#xA;        CASE&#xD;&#xA;            WHEN TRIM(A.NEXT_COUNTING_START_DATE) = '-6847808400000' THEN '1753-01-01'::DATE&#xD;&#xA;            WHEN REGEXP_LIKE(TRIM(A.NEXT_COUNTING_START_DATE), '^-?[0-9]{11,}$')&#xD;&#xA;                THEN CONVERT_TIMEZONE('UTC', 'Europe/Paris', TO_TIMESTAMP_NTZ(TO_NUMBER(TRIM(A.NEXT_COUNTING_START_DATE)), 3))::DATE&#xD;&#xA;            ELSE COALESCE(&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.NEXT_COUNTING_START_DATE), ''), 1, 10), 'YYYY-MM-DD'),&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.NEXT_COUNTING_START_DATE), ''), 1, 10), 'DD/MM/YYYY'))&#xD;&#xA;        END AS NEXT_COUNTING_START_DATE,&#xD;&#xA;        CASE&#xD;&#xA;            WHEN TRIM(A.NEXT_COUNTING_END_DATE) = '-6847808400000' THEN '1753-01-01'::DATE&#xD;&#xA;            WHEN REGEXP_LIKE(TRIM(A.NEXT_COUNTING_END_DATE), '^-?[0-9]{11,}$')&#xD;&#xA;                THEN CONVERT_TIMEZONE('UTC', 'Europe/Paris', TO_TIMESTAMP_NTZ(TO_NUMBER(TRIM(A.NEXT_COUNTING_END_DATE)), 3))::DATE&#xD;&#xA;            ELSE COALESCE(&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.NEXT_COUNTING_END_DATE), ''), 1, 10), 'YYYY-MM-DD'),&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.NEXT_COUNTING_END_DATE), ''), 1, 10), 'DD/MM/YYYY'))&#xD;&#xA;        END AS NEXT_COUNTING_END_DATE,&#xD;&#xA;        CAST(A.UNITE_CONDMNT__MULTIPLE AS VARCHAR(255)) AS UNIT_CONDMNT_MULTIPLE,&#xD;&#xA;        TRY_TO_DOUBLE(A.INTEGRER_DS_CALC__POIDS_FRANCO) AS INT_GRER_DS_CALC_POIDS_FRANCO,&#xD;&#xA;        TRY_TO_DOUBLE(A.ART__DE_TYPE_CONDT_) AS ART_DE_TYPE_CONDT_,&#xD;&#xA;        TRY_TO_DOUBLE(A.MODE_DE_GESTION) AS MODE_DE_GESTION,&#xD;&#xA;        TRY_TO_DOUBLE(A.TYPE_ARTICLE) AS TYPE_ARTICLE,&#xD;&#xA;        TRY_TO_DOUBLE(A.LONGUEUR) AS LONGUEUR,&#xD;&#xA;        TRY_TO_DOUBLE(A.LARGEUR) AS LARGEUR,&#xD;&#xA;        TRY_TO_DOUBLE(A.NON_GERE_EN_STOCK) AS NON_GERE_EN_STOCK,&#xD;&#xA;        TRY_TO_DOUBLE(A.TYPE_CONDITIONNEMENT) AS TYPE_CONDITIONNEMENT,&#xD;&#xA;        TRY_TO_DOUBLE(A.ENTRY_NO__LIST_INVENTORYK) AS ENTRY_NO_LIST_INVENTORYK,&#xD;&#xA;        TRY_TO_DOUBLE(A.END_OF_MARKETING_DATE) AS COUT_SEMIN_DEV_SOC, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.COUT_SEMIN__DEV_SOC) AS ART_COND_NON_MARQUE, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.ART_COND__NON_MARQUE AS VARCHAR(255)) AS CODE_TARIF_CROSS_DOCK, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.CODE_TARIF_CROSS_DOCK) AS RUPTURE_SEMI_FINI, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.RUPTURE_SEMI_FINI) AS ENTRY_NO_LIST_INVENT_ESPIRA, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ENTRY_NO__LIST_INVENT__ESPIRA) AS ENTRY_NO_LIST_INVENT_AMBLAIN, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ENTRY_NO__LIST_INVENT__AMBLAIN) AS ITEM_WITHOUT_GENCOD, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ITEM_WITHOUT_GENCOD) AS COST_TURNOVER, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.COST_TURNOVER) AS ENTRY_NO_LIST_INVENT_PROFIL, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.ENTRY_NO__LIST_INVENT__PROFIL AS VARCHAR(255)) AS CODE_BARRE_EAN13, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.BEST_BEFORE_CALCULATION AS VARCHAR(255)) AS CLE_EAN13, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(IFF(S.NO_ IS NOT NULL, S.GENCODE_EAN13, COALESCE(NULLIF(TRIM(IE.EAN_IE), ''), NULLIF(TRIM(A.WARRANTY_DURATION), ''))) AS VARCHAR(255)) AS GENCODE_EAN13, /* ESP: repris de SEMIN SAS, sinon source (correctif decalage) */&#xD;&#xA;        CAST(A.DISPLAY_BB_ON_LABELS AS VARCHAR(255)) AS SECTIONS_PROFIL, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.CREATE_DATE) AS NORMENF, /* ESP: correctif decalage source */&#xD;&#xA;        /* Talend : colonne ECO_DDS, Db Column = ECO DDS */&#xD;&#xA;        TRY_TO_DOUBLE(A.CODE_BARRE_EAN13) AS ECO_DDS, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.CLE_EAN13 AS VARCHAR(255)) AS SHIP_UNIT_OF_MEASURE, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.GENCODE_EAN13 AS VARCHAR(255)) AS FORECAST_INTERVAL, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.SECTIONS_PROFIL AS VARCHAR(255)) AS HANDLING_UNIT_OF_MEASURE, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.NORMENF) AS QT_MINIMUM_PLANNING, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ECO_DDS) AS COV_VALUE, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.SHIP__UNIT_OF_MEASURE) AS ITEM_STATUS, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.FORECAST_INTERVAL AS VARCHAR(255)) AS HANDLING_TYPE, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.HANDLING_UNIT_OF_MEASURE AS VARCHAR(255)) AS ROUTING_NO, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.QTE_MINIMUM_PLANNING AS VARCHAR(255)) AS PRODUCTION_BOM_NO, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.COV_VALUE) AS SINGLE_LEVEL_MATERIAL_COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ONEBASE_PRODUCT_GROUP_CODE) AS SINGLE_LEVEL_CAPACITY_COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.LEV_1___ACTIVITY) AS SINGLE_LEVEL_SUBCONTRD__COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.LEV_2___ROUTING) AS SINGLE_LEVEL_CAP_OVHD_COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.LEV_3___FAMILY) AS SINGLE_LEVEL_MFG_OVHD_COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.LEV_4___SUB_FAMILY) AS OVERHEAD_RATE, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.PR_ALERT_RULES) AS ROLLED_UP_SUBCONTRACTED_COST, /* ESP: correctif decalage source */&#xD;&#xA;        /* regle ancien job ITEM : cout MFG */&#xD;&#xA;        TRY_TO_DOUBLE(A.DDMRP_ACTIVATE_BY_DEFAULT) AS ROLLED_UP_CAP_OVERHEAD_COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.RECIPE_ROOT) AS ROLLED_UP_CAP__OVERHEAD_COST, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ITEM_STATUS) AS ORDER_TRACKING_POLICY, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.HANDLING_TYPE) AS CRITICAL, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.TPV_CODE AS VARCHAR(255)) AS COMMON_ITEM_NO, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ROUTING_NO_) AS PR_ALERT_RULES, /* ESP: correctif decalage source */&#xD;&#xA;        CASE&#xD;&#xA;            WHEN TRIM(A.PRODUCTION_BOM_NO_) = '-6847808400000' THEN '1753-01-01'::DATE /* ESP: correctif decalage source */&#xD;&#xA;            WHEN REGEXP_LIKE(TRIM(A.PRODUCTION_BOM_NO_), '^-?[0-9]{11,}$') /* ESP: correctif decalage source */&#xD;&#xA;                THEN CONVERT_TIMEZONE('UTC', 'Europe/Paris', TO_TIMESTAMP_NTZ(TO_NUMBER(TRIM(A.PRODUCTION_BOM_NO_)), 3))::DATE /* ESP: correctif decalage source */&#xD;&#xA;            ELSE COALESCE(&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.PRODUCTION_BOM_NO_), ''), 1, 10), 'YYYY-MM-DD'), /* ESP: correctif decalage source */&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.PRODUCTION_BOM_NO_), ''), 1, 10), 'DD/MM/YYYY')) /* ESP: correctif decalage source */&#xD;&#xA;        END AS END_OF_MARKETING_DATE,&#xD;&#xA;        TRY_TO_DOUBLE(A.SINGLE_LEVEL_MATERIAL_COST) AS DDMRP_ACTIVATE_BY_DEFAULT, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.SINGLE_LEVEL_CAPACITY_COST AS VARCHAR(255)) AS RECIPE_ROOT, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.SINGLE_LEVEL_SUBCONTRD__COST AS VARCHAR(255)) AS BEST_BEFORE_CALCULATION, /* ESP: correctif decalage source */&#xD;&#xA;        /* CREATE_DATE avec l heure (comme ITEM prod) */&#xD;&#xA;        CASE&#xD;&#xA;            WHEN TRIM(A.ROLLED_UP_MFG__OVHD_COST) = '-6847808400000' THEN '1753-01-01'::TIMESTAMP_NTZ /* ESP: correctif decalage source */&#xD;&#xA;            WHEN REGEXP_LIKE(TRIM(A.ROLLED_UP_MFG__OVHD_COST), '^-?[0-9]{11,}$') /* ESP: correctif decalage source */&#xD;&#xA;                THEN CONVERT_TIMEZONE('UTC', 'Europe/Paris', TO_TIMESTAMP_NTZ(TO_NUMBER(TRIM(A.ROLLED_UP_MFG__OVHD_COST)), 3)) /* ESP: correctif decalage source */&#xD;&#xA;            ELSE COALESCE(&#xD;&#xA;                TRY_TO_TIMESTAMP_NTZ(NULLIF(TRIM(A.ROLLED_UP_MFG__OVHD_COST), ''), 'YYYY-MM-DD HH24:MI:SS.FF'), /* ESP: correctif decalage source */&#xD;&#xA;                TRY_TO_TIMESTAMP_NTZ(NULLIF(TRIM(A.ROLLED_UP_MFG__OVHD_COST), ''), 'YYYY-MM-DD HH24:MI:SS'), /* ESP: correctif decalage source */&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.ROLLED_UP_MFG__OVHD_COST), ''), 1, 10), 'YYYY-MM-DD')::TIMESTAMP_NTZ, /* ESP: correctif decalage source */&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(A.ROLLED_UP_MFG__OVHD_COST), ''), 1, 10), 'DD/MM/YYYY')::TIMESTAMP_NTZ) /* ESP: correctif decalage source */&#xD;&#xA;        END AS CREATE_DATE,&#xD;&#xA;        CAST(A.ROLLED_UP_CAP__OVERHEAD_COST AS VARCHAR(255)) AS WARRANTY_DURATION, /* ESP: correctif decalage source */&#xD;&#xA;        TRY_TO_DOUBLE(A.ORDER_TRACKING_POLICY) AS DISPLAY_BB_ON_LABELS, /* ESP: correctif decalage source */&#xD;&#xA;        CAST(A.COMMON_ITEM_NO_ AS VARCHAR(255)) AS TPV_CODE /* ESP: correctif decalage source */&#xD;&#xA;    FROM &quot; +context.Snowflake_BDD+&quot;.&quot;+context.Snowflake_Schema_SEMIN_ESP+&quot;.ARTICLE_SEMIN_ESPAGNE A&#xD;&#xA;    LEFT JOIN SAS S&#xD;&#xA;      ON S.NO_ = A.NO_&#xD;&#xA;    LEFT JOIN ITEM_ESP IE  /* ESP: secours si article absent de SEMIN SAS */&#xD;&#xA;      ON IE.NO_IE = A.NO_&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;/* ---------- ETAPE 2 : JOINTURES - autres tables (sans regle) ---------- */&#xD;&#xA;IUM AS (  /* unites de mesure, 1 ligne par (article, code unite) */&#xD;&#xA;    SELECT * FROM &quot; +context.Snowflake_BDD+&quot;.&quot;+context.Snowflake_Schema_SEMIN_ESP+&quot;.\&quot;Item_Unit_of_Measure\&quot;&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY \&quot;Item No_\&quot;, \&quot;Code\&quot; ORDER BY \&quot;Last Date Modified\&quot; DESC) = 1&#xD;&#xA;),&#xD;&#xA;PRB AS (  /* PRB_ITEM : absente de ARTICLE_SEMIN_ESPAGNE, lue dans Item (comme l ancien job ITEM) */&#xD;&#xA;    SELECT \&quot;No_\&quot; AS NO_PRB, \&quot;PRB Item\&quot; AS PRB_ITEM_SRC&#xD;&#xA;    FROM &quot; +context.Snowflake_BDD+&quot;.&quot;+context.Snowflake_Schema_SEMIN_ESP+&quot;.\&quot;Item\&quot;&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY \&quot;No_\&quot; ORDER BY \&quot;No_\&quot;) = 1&#xD;&#xA;),&#xD;&#xA;MARQUE AS (&#xD;&#xA;    SELECT * FROM &quot; +context.Snowflake_BDD+&quot;.&quot;+context.Snowflake_Schema_SEMIN_ESP+&quot;.\&quot;Marque_article\&quot;&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY \&quot;Code Marque\&quot; ORDER BY \&quot;Code\&quot;) = 1&#xD;&#xA;),&#xD;&#xA;JOINTURES AS (&#xD;&#xA;    SELECT&#xD;&#xA;        B.*,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Qty_ per Unit of Measure\&quot;)) AS NUMBER_SALES_UNITS_R2,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUB.\&quot;Qty_ per Unit of Measure\&quot;)) AS NUMBER_BASE_UNITS_R2,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Length\&quot;)) AS LENGTH,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Width\&quot;)) AS WIDTH,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Height\&quot;)) AS HEIGHT,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Cubage\&quot;)) AS CUBAGE,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Weight\&quot;)) AS WEIGHT,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Gross Weight\&quot;)) AS GROSS_WEIGHT,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Net Weight\&quot;)) AS NET_WEIGHT_IUM,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Diameter\&quot;)) AS DIAMETER,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;Layer per pallet\&quot;)) AS LAYER_PER_PALLET,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(IUV.\&quot;FABDIS Unit\&quot;)) AS FABDIS_UNIT,&#xD;&#xA;        CASE&#xD;&#xA;            WHEN TRIM(TO_VARCHAR(IUV.\&quot;Last Date Modified\&quot;)) = '-6847808400000' THEN '1753-01-01'::DATE&#xD;&#xA;            WHEN REGEXP_LIKE(TRIM(TO_VARCHAR(IUV.\&quot;Last Date Modified\&quot;)), '^-?[0-9]{11,}$')&#xD;&#xA;                THEN CONVERT_TIMEZONE('UTC', 'Europe/Paris', TO_TIMESTAMP_NTZ(TO_NUMBER(TRIM(TO_VARCHAR(IUV.\&quot;Last Date Modified\&quot;))), 3))::DATE&#xD;&#xA;            ELSE COALESCE(&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(TO_VARCHAR(IUV.\&quot;Last Date Modified\&quot;)), ''), 1, 10), 'YYYY-MM-DD'),&#xD;&#xA;                TRY_TO_DATE(SUBSTR(NULLIF(TRIM(TO_VARCHAR(IUV.\&quot;Last Date Modified\&quot;)), ''), 1, 10), 'DD/MM/YYYY'))&#xD;&#xA;        END AS LAST_DATE_MODIFIED,&#xD;&#xA;        CAST(M.\&quot;Brand Type\&quot; AS VARCHAR(255)) AS BRAND_TYPE,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(P.PRB_ITEM_SRC)) AS PRB_ITEM&#xD;&#xA;    FROM BASE B&#xD;&#xA;    LEFT JOIN IUM IUV  /* unite de VENTE */&#xD;&#xA;      ON IUV.\&quot;Item No_\&quot; = B.NO_&#xD;&#xA;     AND IUV.\&quot;Code\&quot;     = B.SALES_UNIT_OF_MEASURE&#xD;&#xA;    LEFT JOIN IUM IUB  /* unite de BASE */&#xD;&#xA;      ON IUB.\&quot;Item No_\&quot; = B.NO_&#xD;&#xA;     AND IUB.\&quot;Code\&quot;     = B.BASE_UNIT_OF_MEASURE&#xD;&#xA;    LEFT JOIN MARQUE M&#xD;&#xA;      ON M.\&quot;Code Marque\&quot; = B.CODE_MARQUE&#xD;&#xA;    LEFT JOIN PRB P&#xD;&#xA;      ON P.NO_PRB = B.NO_&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;/* ---------- ETAPE 3 : REGLES - enrichissement ---------- */&#xD;&#xA;REGLES AS (&#xD;&#xA;    SELECT&#xD;&#xA;        J.*,&#xD;&#xA;        'SEMIN_ESPAGNE' AS DATABASE_ORIGIN,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.NO_                         AS ARTICLE_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.CODE_MARQUE                 AS MARQUE_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.CODE_CLASSE                 AS CLASSE_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.ONEBASE_PRODUCT_GROUP_CODE  AS ONEBASE_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.LEV_1___ACTIVITY            AS LEVEL1_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.LEV_2___ROUTING             AS LEVEL2_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.LEV_3___FAMILY              AS LEVEL3_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.LEV_4___SUB_FAMILY          AS LEVEL4_KEY,&#xD;&#xA;        'SEMIN_ESPAGNE' || ' ' || J.ITEM_CATEGORY_CODE          AS ITEMCATEGORYCODE_KEY,&#xD;&#xA;        /* regle ancien job ITEM : LEV_3 = 2030100 ou 2030110 force LEV_1 et LEV_2 */&#xD;&#xA;        CASE WHEN J.LEV_3___FAMILY IN ('2030100', '2030110') THEN '203'   ELSE J.LEV_1___ACTIVITY END AS LEV_1_ACTIVITY,&#xD;&#xA;        CASE WHEN J.LEV_3___FAMILY IN ('2030100', '2030110') THEN '20301' ELSE J.LEV_2___ROUTING  END AS LEV_2_ROUTING,&#xD;&#xA;        J.LEV_3___FAMILY     AS LEV_3_FAMILY,&#xD;&#xA;        J.LEV_4___SUB_FAMILY AS LEV_4_SUB_FAMILY&#xD;&#xA;    FROM JOINTURES J&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;/* ---------- ETAPE 4 : REFERENTIELS - dependent des regles ---------- */&#xD;&#xA;HIERARCHIE AS (  /* ESP : libelles pris dans la hierarchie SEMIN_SAS (codes et libelles identiques, verifie le 06/11/2026) */&#xD;&#xA;    SELECT * FROM &quot; +context.Snowflake_BDD_Silver+&quot;.&quot;+context.Snowflake_Schema_Silver+&quot;.ITEM_HIERARCHY_LEVEL&#xD;&#xA;    WHERE FILIALE = 'SEMIN_SAS'&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY LEVEL, CODE ORDER BY DESCRIPTION) = 1&#xD;&#xA;),&#xD;&#xA;MAPPING_UNITE AS (&#xD;&#xA;    SELECT * FROM &quot; +context.Snowflake_BDD_Silver+&quot;.SILVER_REF.MAPPING_UNITE&#xD;&#xA;    QUALIFY ROW_NUMBER() OVER (PARTITION BY ACTIVITE ORDER BY UNITE_ANALYSE_VOLUMES) = 1&#xD;&#xA;),&#xD;&#xA;REFERENTIELS AS (&#xD;&#xA;    SELECT&#xD;&#xA;        R.*,&#xD;&#xA;        CAST(H1.DESCRIPTION AS VARCHAR(255)) AS DESCRIPTION_LEVEL1,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(H1.LEVEL)) AS LEVEL_1,&#xD;&#xA;        CAST(H2.DESCRIPTION AS VARCHAR(255)) AS DESCRIPTION_LEVEL2,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(H2.LEVEL)) AS LEVEL_2,&#xD;&#xA;        CAST(H3.DESCRIPTION AS VARCHAR(255)) AS DESCRIPTION_LEVEL3,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(H3.LEVEL)) AS LEVEL_3,&#xD;&#xA;        CAST(H4.DESCRIPTION AS VARCHAR(255)) AS DESCRIPTION_LEVEL4,&#xD;&#xA;        TRY_TO_DOUBLE(TO_VARCHAR(H4.LEVEL)) AS LEVEL_4,&#xD;&#xA;        CAST(U.UNITE_ANALYSE_VOLUMES AS VARCHAR(255)) AS UNITE_DE_MESURE&#xD;&#xA;    FROM REGLES R&#xD;&#xA;    LEFT JOIN HIERARCHIE H1&#xD;&#xA;      ON H1.LEVEL = 1&#xD;&#xA;     AND H1.CODE  = R.LEV_1_ACTIVITY&#xD;&#xA;    LEFT JOIN HIERARCHIE H2&#xD;&#xA;      ON H2.LEVEL = 2&#xD;&#xA;     AND H2.CODE  = R.LEV_2_ROUTING&#xD;&#xA;    LEFT JOIN HIERARCHIE H3&#xD;&#xA;      ON H3.LEVEL = 3&#xD;&#xA;     AND H3.CODE  = R.LEV_3_FAMILY&#xD;&#xA;    LEFT JOIN HIERARCHIE H4&#xD;&#xA;      ON H4.LEVEL = 4&#xD;&#xA;     AND H4.CODE  = R.LEV_4_SUB_FAMILY&#xD;&#xA;    LEFT JOIN MAPPING_UNITE U&#xD;&#xA;      ON U.ACTIVITE = H1.DESCRIPTION&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;/* ---------- RESULTAT : 188 colonnes dans l ordre de la table ---------- */&#xD;&#xA;SELECT&#xD;&#xA;    NO_,&#xD;&#xA;    DESCRIPTION,&#xD;&#xA;    CODE_MARQUE,&#xD;&#xA;    CODE_CLASSE,&#xD;&#xA;    ONEBASE_PRODUCT_GROUP_CODE,&#xD;&#xA;    ITEM_CATEGORY_CODE,&#xD;&#xA;    LEV_1___ACTIVITY,&#xD;&#xA;    LEV_2___ROUTING,&#xD;&#xA;    LEV_3___FAMILY,&#xD;&#xA;    LEV_4___SUB_FAMILY,&#xD;&#xA;    DATABASE_ORIGIN,&#xD;&#xA;    ARTICLE_KEY,&#xD;&#xA;    MARQUE_KEY,&#xD;&#xA;    CLASSE_KEY,&#xD;&#xA;    ONEBASE_KEY,&#xD;&#xA;    LEVEL1_KEY,&#xD;&#xA;    LEVEL2_KEY,&#xD;&#xA;    LEVEL3_KEY,&#xD;&#xA;    LEVEL4_KEY,&#xD;&#xA;    ITEMCATEGORYCODE_KEY,&#xD;&#xA;    BASE_UNIT_OF_MEASURE,&#xD;&#xA;    NET_WEIGHT,&#xD;&#xA;    NO__2,&#xD;&#xA;    SEARCH_DESCRIPTION,&#xD;&#xA;    DESCRIPTION_2,&#xD;&#xA;    PRICE_UNIT_CONVERSION,&#xD;&#xA;    TYPE,&#xD;&#xA;    INVENTORY_POSTING_GROUP,&#xD;&#xA;    SHELF_NO_,&#xD;&#xA;    ITEM_DISC__GROUP,&#xD;&#xA;    ALLOW_INVOICE_DISC,&#xD;&#xA;    STATISTICS_GROUP,&#xD;&#xA;    COMMISSION_GROUP,&#xD;&#xA;    UNIT_PRICE,&#xD;&#xA;    PRICE_PROFIT_CALCULATION,&#xD;&#xA;    PROFIT,&#xD;&#xA;    LAST_DIRECT_COST,&#xD;&#xA;    INDIRECT_COST,&#xD;&#xA;    COST_IS_ADJUSTED,&#xD;&#xA;    ALLOW_ONLINE_ADJUSTMENT,&#xD;&#xA;    VENDOR_ITEM_NO,&#xD;&#xA;    LEAD_TIME_CALCULATION,&#xD;&#xA;    MAXIMUM_INVENTORY,&#xD;&#xA;    REORDER_QUANTITY,&#xD;&#xA;    ALTERNATIVE_ITEM_NO,&#xD;&#xA;    UNIT_LIST_PRICE,&#xD;&#xA;    UNITS_PER_PARCEL,&#xD;&#xA;    UNIT_VOLUME,&#xD;&#xA;    DURABILITY,&#xD;&#xA;    FREIGHT_TYPE,&#xD;&#xA;    TARIFF_NO,&#xD;&#xA;    DUTY_UNIT_CONVERSION,&#xD;&#xA;    COUNTRY_REGION_PURCHASED_CODE,&#xD;&#xA;    BUDGETED_AMOUNT,&#xD;&#xA;    BUDGET_PROFIT,&#xD;&#xA;    BLOCKED,&#xD;&#xA;    PRICE_INCLUDES_VAT,&#xD;&#xA;    VAT_BUS_POSTING_GR_PRICE,&#xD;&#xA;    GEN_PROD_POSTING_GROUP,&#xD;&#xA;    PICTURE,&#xD;&#xA;    COUNTRY_REGION_OF_ORIGIN_CODE,&#xD;&#xA;    AUTOMATIC_EXT_TEXTS,&#xD;&#xA;    NO_SERIES,&#xD;&#xA;    TAX_GROUP_CODE,&#xD;&#xA;    VAT_PROD_POSTING_GROUP,&#xD;&#xA;    DEFAULT_DEFERRAL_TEMPLATE_CODE,&#xD;&#xA;    LOW_LEVEL_CODE,&#xD;&#xA;    LOT_SIZE,&#xD;&#xA;    ROLLED_UP_CAPACITY_COST,&#xD;&#xA;    SCRAP,&#xD;&#xA;    INVENTORY_VALUE_ZERO,&#xD;&#xA;    DISCRETE_ORDER_QUANTITY,&#xD;&#xA;    MINIMUM_ORDER_QUANTITY,&#xD;&#xA;    MAXIMUM_ORDER_QUANTITY,&#xD;&#xA;    SAFETY_STOCK_QUANTITY,&#xD;&#xA;    ORDER_MULTIPLE,&#xD;&#xA;    SAFETY_LEAD_TIME,&#xD;&#xA;    FLUSHING_METHOD,&#xD;&#xA;    REPLENISHMENT_SYSTEM,&#xD;&#xA;    ROUNDING_PRECISION,&#xD;&#xA;    SALES_UNIT_OF_MEASURE,&#xD;&#xA;    PURCH__UNIT_OF_MEASURE,&#xD;&#xA;    TIME_BUCKET,&#xD;&#xA;    REORDERING_POLICY,&#xD;&#xA;    INCLUDE_INVENTORY,&#xD;&#xA;    MANUFACTURING_POLICY,&#xD;&#xA;    RESCHEDULING_PERIOD,&#xD;&#xA;    LOT_ACCUMULATION_PERIOD,&#xD;&#xA;    DAMPENER_PERIOD,&#xD;&#xA;    DAMPENER_QUANTITY,&#xD;&#xA;    OVERFLOW_LEVEL,&#xD;&#xA;    CREATED_FROM_NONSTOCK_ITEM,&#xD;&#xA;    PRODUCT_GROUP_CODE,&#xD;&#xA;    SERVICE_ITEM_GROUP,&#xD;&#xA;    ITEM_TRACKING_CODE,&#xD;&#xA;    LOT_NOS,&#xD;&#xA;    EXPIRATION_CALCULATION,&#xD;&#xA;    SPECIAL_EQUIPMENT_CODE,&#xD;&#xA;    PUT_AWAY_TEMPLATE_CODE,&#xD;&#xA;    PUT_AWAY_UNIT_OF_MEASURE_CODE,&#xD;&#xA;    PHYS_INVT_COUNTING_PERIOD_CODE,&#xD;&#xA;    LAST_COUNTING_PERIOD_UPDATE,&#xD;&#xA;    USE_CROSS_DOCKING,&#xD;&#xA;    NEXT_COUNTING_START_DATE,&#xD;&#xA;    NEXT_COUNTING_END_DATE,&#xD;&#xA;    UNIT_CONDMNT_MULTIPLE,&#xD;&#xA;    INT_GRER_DS_CALC_POIDS_FRANCO,&#xD;&#xA;    ART_DE_TYPE_CONDT_,&#xD;&#xA;    MODE_DE_GESTION,&#xD;&#xA;    TYPE_ARTICLE,&#xD;&#xA;    LONGUEUR,&#xD;&#xA;    LARGEUR,&#xD;&#xA;    NON_GERE_EN_STOCK,&#xD;&#xA;    TYPE_CONDITIONNEMENT,&#xD;&#xA;    ENTRY_NO_LIST_INVENTORYK,&#xD;&#xA;    COUT_SEMIN_DEV_SOC,&#xD;&#xA;    ART_COND_NON_MARQUE,&#xD;&#xA;    CODE_TARIF_CROSS_DOCK,&#xD;&#xA;    RUPTURE_SEMI_FINI,&#xD;&#xA;    ENTRY_NO_LIST_INVENT_ESPIRA,&#xD;&#xA;    ENTRY_NO_LIST_INVENT_AMBLAIN,&#xD;&#xA;    ITEM_WITHOUT_GENCOD,&#xD;&#xA;    COST_TURNOVER,&#xD;&#xA;    ENTRY_NO_LIST_INVENT_PROFIL,&#xD;&#xA;    CODE_BARRE_EAN13,&#xD;&#xA;    CLE_EAN13,&#xD;&#xA;    GENCODE_EAN13,&#xD;&#xA;    SECTIONS_PROFIL,&#xD;&#xA;    NORMENF,&#xD;&#xA;    ECO_DDS,&#xD;&#xA;    SHIP_UNIT_OF_MEASURE,&#xD;&#xA;    FORECAST_INTERVAL,&#xD;&#xA;    HANDLING_UNIT_OF_MEASURE,&#xD;&#xA;    QT_MINIMUM_PLANNING,&#xD;&#xA;    COV_VALUE,&#xD;&#xA;    ITEM_STATUS,&#xD;&#xA;    HANDLING_TYPE,&#xD;&#xA;    ROUTING_NO,&#xD;&#xA;    PRODUCTION_BOM_NO,&#xD;&#xA;    SINGLE_LEVEL_MATERIAL_COST,&#xD;&#xA;    SINGLE_LEVEL_CAPACITY_COST,&#xD;&#xA;    SINGLE_LEVEL_SUBCONTRD__COST,&#xD;&#xA;    SINGLE_LEVEL_CAP_OVHD_COST,&#xD;&#xA;    SINGLE_LEVEL_MFG_OVHD_COST,&#xD;&#xA;    OVERHEAD_RATE,&#xD;&#xA;    ROLLED_UP_SUBCONTRACTED_COST,&#xD;&#xA;    ROLLED_UP_CAP_OVERHEAD_COST,&#xD;&#xA;    ROLLED_UP_CAP__OVERHEAD_COST,&#xD;&#xA;    ORDER_TRACKING_POLICY,&#xD;&#xA;    CRITICAL,&#xD;&#xA;    COMMON_ITEM_NO,&#xD;&#xA;    PR_ALERT_RULES,&#xD;&#xA;    END_OF_MARKETING_DATE,&#xD;&#xA;    DDMRP_ACTIVATE_BY_DEFAULT,&#xD;&#xA;    RECIPE_ROOT,&#xD;&#xA;    BEST_BEFORE_CALCULATION,&#xD;&#xA;    CREATE_DATE,&#xD;&#xA;    WARRANTY_DURATION,&#xD;&#xA;    DISPLAY_BB_ON_LABELS,&#xD;&#xA;    TPV_CODE,&#xD;&#xA;    PRB_ITEM,&#xD;&#xA;    NUMBER_SALES_UNITS_R2,&#xD;&#xA;    NUMBER_BASE_UNITS_R2,&#xD;&#xA;    LENGTH,&#xD;&#xA;    WIDTH,&#xD;&#xA;    HEIGHT,&#xD;&#xA;    CUBAGE,&#xD;&#xA;    WEIGHT,&#xD;&#xA;    GROSS_WEIGHT,&#xD;&#xA;    NET_WEIGHT_IUM,&#xD;&#xA;    DIAMETER,&#xD;&#xA;    LAYER_PER_PALLET,&#xD;&#xA;    FABDIS_UNIT,&#xD;&#xA;    LAST_DATE_MODIFIED,&#xD;&#xA;    DESCRIPTION_LEVEL1,&#xD;&#xA;    LEVEL_1,&#xD;&#xA;    DESCRIPTION_LEVEL2,&#xD;&#xA;    LEVEL_2,&#xD;&#xA;    DESCRIPTION_LEVEL3,&#xD;&#xA;    LEVEL_3,&#xD;&#xA;    DESCRIPTION_LEVEL4,&#xD;&#xA;    LEVEL_4,&#xD;&#xA;    BRAND_TYPE,&#xD;&#xA;    UNITE_DE_MESURE,&#xD;&#xA;    LEV_1_ACTIVITY,&#xD;&#xA;    LEV_2_ROUTING,&#xD;&#xA;    LEV_3_FAMILY,&#xD;&#xA;    LEV_4_SUB_FAMILY&#xD;&#xA;FROM REFERENTIELS&quot;"/>
    <elementParameter field="CHECK" name="configuration.dataSet.dataStore.autoCommit" value="true" show="false"/>
    <elementParameter field="TEXT" name="configuration.dataSet.dataStore.jdbcParameters" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="configuration.dataSet.dataStore.loginTimeout" value="15" show="false"/>
    <elementParameter field="TEXT" name="configuration.dataSet.dataStore.role" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="configuration.dataSet.dataStore.jdbcUrlSuffix" value="&quot;.snowflakecomputing.com&quot;" show="false"/>
    <elementParameter field="CHECK" name="configuration.dataSet.useUnquotedObjectIdentifiers" value="true" show="false"/>
    <elementParameter field="CHECK" name="configuration.dataSet.useSessionTimezone" value="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tDBConnection_1"/>
    <elementParameter field="TECHNICAL" name="configuration.dataSet.__version" value="-1" show="false"/>
    <elementParameter field="TECHNICAL" name="configuration.dataSet.dataStore.__version" value="-1" show="false"/>
    <metadata connector="FLOW" label="metadata" name="tSnowflakeInput_1">
      <column comment="" key="true" length="255" name="NO_" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" key="false" length="255" name="DESCRIPTION" nullable="true" pattern="" precision="-1" sourceType="VARCHAR" type="id_String" originalLength="-1" usefulColumn="true"/>

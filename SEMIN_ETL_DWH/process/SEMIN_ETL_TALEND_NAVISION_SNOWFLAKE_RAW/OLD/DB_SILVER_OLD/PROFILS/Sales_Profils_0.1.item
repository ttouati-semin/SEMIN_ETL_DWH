        <mapperTableEntries name="INVOICED_QUANTITY_VALUES_ENTRY_R1" expression="(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    VE.INVOICED_QUANTITY != null ? VE.INVOICED_QUANTITY : BigDecimal.ZERO&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;).multiply(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    Item_silver.NET_WEIGHT != null ? Item_silver.NET_WEIGHT : BigDecimal.ZERO&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;).multiply(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    new BigDecimal(&quot;-1&quot;)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;) " type="id_BigDecimal" nullable="true"/>

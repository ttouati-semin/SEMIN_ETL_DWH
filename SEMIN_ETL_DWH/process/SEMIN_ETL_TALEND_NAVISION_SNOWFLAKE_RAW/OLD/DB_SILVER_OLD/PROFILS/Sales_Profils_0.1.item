        <mapperTableEntries name="QUANTITY_UNIT_OF_SALES_R2" expression="(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    VE.INVOICED_QUANTITY != null&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &amp;&amp; Item_silver.NUMBER_SALES_UNITS_R2 != null&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &amp;&amp; Item_silver.NUMBER_BASE_UNITS_R2 != null&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &amp;&amp; Item_silver.NUMBER_BASE_UNITS_R2.compareTo(BigDecimal.ZERO) != 0&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    ? VE.INVOICED_QUANTITY&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;        .multiply(Item_silver.NUMBER_SALES_UNITS_R2)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;        .divide(Item_silver.NUMBER_BASE_UNITS_R2, 10, java.math.RoundingMode.HALF_UP)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;        .multiply(new BigDecimal(-1))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    : BigDecimal.ZERO " type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="INTERCOMPANY_R8" expression="(java.util.Arrays.asList(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;ES7633&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;995399&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;C0009&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;SEMI001&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;998694&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;996373&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;DE7829&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;CZ7039&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;PL7000&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;PL7020&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    &quot;DZ7011&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;).contains(VE.SOURCE_NO_))&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    ? &quot;IC - Intercompany&quot;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;    : &quot;Non-IC&quot; " type="id_String" nullable="true"/>
